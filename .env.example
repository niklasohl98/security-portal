# Nicht-geheime Einstellungen (Umgebungsvariablen). Geheimnisse gehören NICHT hierher,
# sondern als Docker-Secrets nach /run/secrets/. Nur setzen, was vom Standard abweicht.

# Verzeichnis für SQLite-Datei und Laufdaten (Standard: /data)
# KW_DATA_DIR=/data

# SQLAlchemy-URL (Standard: sqlite:///<KW_DATA_DIR>/kontenwaechter.db)
# KW_DATABASE_URL=sqlite:////data/kontenwaechter.db

# Pfad zur Mandanten-YAML (Standard: /config/tenants.yaml; Vorlage: config/tenants.example.yaml)
# KW_TENANTS_FILE=/config/tenants.yaml

# Verzeichnis der Docker-Secrets (Standard: /run/secrets)
# KW_SECRETS_DIR=/run/secrets

# Optionale SKU-Namenstabelle (Standard: /config/sku_names.yaml; Vorlage: config/sku_names.example.yaml)
# KW_SKU_NAMES_FILE=/config/sku_names.yaml

# Log-Stufe: DEBUG, INFO, WARNING, ERROR (Standard: INFO)
# KW_LOG_LEVEL=INFO

# Täglicher Abruf im App-Prozess: 1 = an (Standard), 0 = aus
# KW_SCHEDULER_ENABLED=1

# Uhrzeit des täglichen Abrufs, HH:MM in KW_TIMEZONE (Standard: 03:00)
# KW_SYNC_TIME=03:00

# IANA-Zeitzone für Zeitplan, Anzeige und Export (Standard: Europe/Berlin)
# KW_TIMEZONE=Europe/Berlin

# Aufbewahrung der Rohdaten alter Läufe in Tagen (Standard: 90)
# KW_RETENTION_DAYS=90

# Lebensdauer einer Anmeldung in Stunden (Standard: 8)
# KW_SESSION_HOURS=8

# Fehlversuche bis zur Sperre eines Kontos und Dauer der Sperre in Minuten (Standard: 5 und 15)
# KW_LOGIN_MAX_ATTEMPTS=5
# KW_LOGIN_LOCKOUT_MINUTES=15

# Secure-Flag des Sitzungs-Cookies: auto (nur bei HTTPS, Standard), 1 oder 0
# KW_COOKIE_SECURE=auto

# Nächtliche Datenbanksicherung: Uhrzeit HH:MM in KW_TIMEZONE (Standard: 02:30)
# KW_BACKUP_TIME=02:30

# So viele Tage bleiben Sicherungen, die neueste immer (Standard: 14)
# KW_BACKUP_KEEP_DAYS=14

# Die Übersicht warnt, wenn die letzte gelungene Sicherung älter ist (Standard: 36 Stunden)
# KW_BACKUP_WARN_HOURS=36

# Verzeichnis der Sicherungen im Container (Standard: /backup; in docker-compose.yml eingehängt)
# KW_BACKUP_DIR=/backup

# Mail-Bericht (Wochenbericht je Mandant) über Exchange Online / Microsoft Graph, aus dem Softchem-
# Tenant (eigene App-Registrierung, NICHT die Zugänge zu den Kunden-Tenants). Einrichtung:
# docs/mail-setup.md. Ohne KW_MAIL_FROM wird nichts gesendet.
# Postfach, als das gesendet wird (Exchange-Berechtigung auf genau dieses Postfach begrenzen)
# KW_MAIL_FROM=kontenwaechter@softchem.example
# Verzeichnis-ID (Tenant) und Anwendungs-ID der Mail-App
# KW_MAIL_TENANT_ID=00000000-0000-0000-0000-000000000000
# KW_MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Zertifikat-Login: Name des Docker-Secrets mit dem privaten Schlüssel (PEM) und SHA-1-Fingerabdruck
# KW_MAIL_CERT_SECRET=mail_cert
# KW_MAIL_CERT_THUMBPRINT=0123456789ABCDEF0123456789ABCDEF01234567
# Wann der Bericht läuft: Wochentag mon..sun und Uhrzeit HH:MM in KW_TIMEZONE (Standard: mon 07:30)
# KW_REPORT_WEEKDAY=mon
# KW_REPORT_TIME=07:30
